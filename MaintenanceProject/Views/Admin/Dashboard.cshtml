@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>
<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Total Requests</h5>
                <p class="display-6">@ViewData["Total"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Completed</h5>
                <p class="display-6">@ViewData["Completed"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Pending</h5>
                <p class="display-6">@ViewData["Pending"]</p>
            </div>
        </div>
    </div>
</div>

<p>
    <a asp-action="ExportCsv" class="btn btn-outline-primary">Export CSV</a>
</p>
