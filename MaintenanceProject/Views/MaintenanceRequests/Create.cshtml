@model MaintenanceProject.Models.MaintenanceRequestCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create Maintenance Request</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RequestDate" class="form-label"></label>
                <input asp-for="RequestDate" class="form-control" type="date" />
                <span asp-validation-for="RequestDate" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsCompleted" class="form-check-input" />
                <label asp-for="IsCompleted" class="form-check-label"></label>
                <span asp-validation-for="IsCompleted" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>
